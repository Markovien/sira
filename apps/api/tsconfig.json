{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS s'appuie sur la reflexion des decorateurs pour l'injection de
    // dependances. Trois reglages du tsconfig de base doivent donc etre levés
    // ici, et seulement ici (voir decisions.md) :
    //  - verbatimModuleSyntax effacerait les imports de types utilises comme
    //    types de parametres de constructeur, que emitDecoratorMetadata doit
    //    justement pouvoir lire ;
    //  - module ESNext : NestJS est stable en CommonJS, pas en ESM ;
    //  - moduleResolution node : coherent avec CommonJS.
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "target": "ES2022",
    "lib": ["ES2022"],
    // multer : @types/multer augmente le namespace Express ; sans cette
    // entree, Express.Multer.File reste introuvable.
    "types": ["node", "multer"],
    "outDir": "./dist",
    "baseUrl": ".",
    "noEmit": true,

    // Nest instancie les providers par reflexion : les champs sont affectes
    // hors du constructeur dans certains cas.
    "strictPropertyInitialization": false
  },
  // Motif generique et non liste explicite : une config de test ajoutee ne
  // doit pas sortir du typecheck par simple oubli — c'est deja arrive.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
