# SIRA — variables d'environnement locales.
# Copier vers .env :  cp .env.example .env
# .env n'est JAMAIS commite ; ce fichier-ci l'est et doit rester a jour.
#
# Toutes les valeurs ci-dessous ont un defaut equivalent dans
# infra/docker-compose.yml : l'environnement demarre sans .env. Ce fichier sert
# a surcharger (ports deja pris, mot de passe non trivial, machine distante).

# --- PostgreSQL + PostGIS ---------------------------------------------------
POSTGRES_USER=sira
POSTGRES_PASSWORD=change-me-en-local
POSTGRES_DB=sira
POSTGRES_PORT=5432

# Chaine de connexion Prisma (apps/api, Phase 1). Doit rester coherente avec
# les quatre variables ci-dessus.
DATABASE_URL=postgresql://sira:change-me-en-local@localhost:5432/sira?schema=public

# --- OSRM (routage) ---------------------------------------------------------
OSRM_PORT=5000
OSRM_URL=http://localhost:5000
# Base du nom des fichiers produits par infra/osrm/prepare.sh. Geofabrik
# publie l'extrait sous le slug 'ivory-coast' et non 'cote-divoire'.
OSM_EXTRACT_NAME=ivory-coast-latest

# --- Photon (geocodage) -----------------------------------------------------
PHOTON_PORT=2322
PHOTON_URL=http://localhost:2322

# --- API (Phase 1) ----------------------------------------------------------
# Generer des valeurs aleatoires distinctes :  openssl rand -base64 48
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Solveur VRP (Phase 2) --------------------------------------------------
VRP_SOLVER_PORT=8000
VRP_SOLVER_URL=http://localhost:8000
VRP_SOLVER_TIME_LIMIT_SECONDS=10
