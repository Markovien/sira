# Expo et les bindings natifs de React Native supportent mal les liens
# symboliques de pnpm : on aplatit node_modules (decision d'architecture,
# voir CLAUDE.md). A ne pas retirer sans avoir revalide un build EAS.
node-linker=hoisted

# Une version de Node non conforme au champ "engines" doit echouer tot,
# pas produire un lockfile subtilement different.
engine-strict=true

# Les dependances de pair manquantes sont des bugs, pas des avertissements.
strict-peer-dependencies=false
auto-install-peers=true
