{
  "name": "sira",
  "version": "0.1.0",
  "private": true,
  "description": "SIRA — optimisation de tournees de livraison urbaine en Cote d'Ivoire",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "bench": "turbo run bench",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:validate": "pnpm --filter @sira/shared exec vitest run test/dataset.test.ts",
    "data:check": "bash data/check-generated.sh",
    "infra:up": "bash infra/compose.sh up -d",
    "infra:down": "bash infra/compose.sh down",
    "infra:logs": "bash infra/compose.sh logs -f",
    "infra:smoke": "bash infra/smoke-test.sh",
    "prepare:osrm": "bash infra/osrm/prepare.sh",
    "prepare:photon": "bash infra/photon/prepare.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
